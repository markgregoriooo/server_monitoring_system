  <diagram id="lvl1clean" name="Level 1 - DFD">
    <mxGraphModel dx="3433" dy="1873" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" value="Level 1 Data Flow Diagram — Server Infrastructure Monitoring System" vertex="1">
          <mxGeometry height="26" width="1100" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="CSPC — ICTU. Gane–Sarson notation. One band per process: external entities on the left, the process in the centre, data stores on the right. Every data flow is a separate line with its own connection point — no two flows share a segment." vertex="1">
          <mxGeometry height="20" width="1500" x="60" y="58" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="*  Duplicated symbol. The same external entity or data store is drawn more than once so that no flow line has to cross another. There is still only one IT Staff, one &lt;i&gt;users&lt;/i&gt; table, and so on." vertex="1">
          <mxGeometry height="20" width="1500" x="60" y="78" as="geometry" />
        </mxCell>
        <mxCell id="lgTitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" value="Legend" vertex="1">
          <mxGeometry height="20" width="200" x="60" y="2730" as="geometry" />
        </mxCell>
        <mxCell id="lgProc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="n.0&lt;br&gt;Process" vertex="1">
          <mxGeometry height="52" width="150" x="60" y="2762" as="geometry" />
        </mxCell>
