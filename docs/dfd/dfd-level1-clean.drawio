        </mxCell>
        <mxCell id="lgStId" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#333333;fontSize=11;" value="Dn" vertex="1">
          <mxGeometry height="52" width="44" x="420" y="2762" as="geometry" />
        </mxCell>
        <mxCell id="lgStNm" parent="1" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;spacingLeft=8;" value="Data store" vertex="1">
          <mxGeometry height="52" width="150" x="464" y="2762" as="geometry" />
        </mxCell>
        <mxCell id="lgFlow" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" value="data flow">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="2788" as="sourcePoint" />
            <mxPoint x="830" y="2788" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lgNote0" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="&lt;b&gt;Balanced with the Level 0 context diagram.&lt;/b&gt; 29 flows cross the system boundary here (8 at 1.0, 11 at 2.0, 4 at 3.0, 2 at 4.0, 3 at 5.0, 1 at 6.0); each rolls up into exactly one of the 16 composite flows drawn at Level 0. Data stores and the three process-to-process flows are internal to this level and correctly do not appear at Level 0." vertex="1">
          <mxGeometry height="20" width="1800" x="60" y="2848" as="geometry" />
        </mxCell>
        <mxCell id="lgNote1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Admin holds every IT Staff flow in addition to the four admin-exclusive flows drawn at both levels (registration approvals, enrollment keys, threshold rule edits and gas-sensor setup), so the two diagrams stay consistent." vertex="1">
          <mxGeometry height="20" width="1800" x="60" y="2874" as="geometry" />
        </mxCell>
        <mxCell id="lgNote2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="Three flows run between processes rather than within a band: 2.0→3.0 (evaluated sample), 2.0→4.0 (temperature zone change) and 6.0→3.0 (forecast alert). Each is routed in its own reserved corridor." vertex="1">
          <mxGeometry height="20" width="1800" x="60" y="2900" as="geometry" />
        </mxCell>
