<mxfile host="app.diagrams.net">
  <diagram id="lvl0clean" name="Level 0 - Context Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITLE ============ -->
        <mxCell id="t1" value="Level 0 (Context) Data Flow Diagram &#8212; Server Infrastructure Monitoring System" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="28" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="CSPC &#8212; ICTU. Gane&#8211;Sarson notation. Each data flow has its own connection point and its own straight line: no two flows share a segment." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="54" width="1100" height="20" as="geometry" />
        </mxCell>

        <!-- ============ CENTRAL PROCESS ============ -->
        <mxCell id="p0" value="0&lt;br&gt;&lt;br&gt;Server Infrastructure&lt;br&gt;Monitoring System" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="320" height="620" as="geometry" />
        </mxCell>

        <!-- ============ LEFT EXTERNAL ENTITIES ============ -->
        <mxCell id="eAdmin" value="Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="102" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="eStaff" value="IT Staff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="252" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="eRoom" value="Server Room (physical)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eSrv" value="Monitored Server" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- ============ RIGHT EXTERNAL ENTITIES ============ -->
        <mxCell id="eRtr" value="Router / MikroTik" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="110" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eUps" value="UPS Unit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="250" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eAc" value="Air Conditioner Unit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="390" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eGoog" value="Google Workspace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="510" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eMail" value="Email Recipient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="650" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- ============ FLOWS: ADMIN ============ -->
        <mxCell id="f01" value="sign-in, user approvals, alert-rule configuration,&lt;br&gt;gas-sensor setup &amp;amp; enrollment keys" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.0484;entryDx=0;entryDy=0;" edge="1" parent="1" source="eAdmin" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f02" value="session &amp;amp; role" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.1387;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eAdmin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ FLOWS: IT STAFF ============ -->
        <mxCell id="f03" value="sign-in, acknowledgements,&lt;br&gt;AC control &amp;amp; report requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.2903;entryDx=0;entryDy=0;" edge="1" parent="1" source="eStaff" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f04" value="session, live dashboards,&lt;br&gt;alerts, reports &amp;amp; forecasts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3806;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eStaff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ FLOWS: SERVER ROOM / SERVER ============ -->
        <mxCell id="f05" value="temperature, humidity, gas&lt;br&gt;&amp;amp; gas-sensor pin map" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5113;entryDx=0;entryDy=0;" edge="1" parent="1" source="eRoom" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f06" value="server metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.6935;entryDx=0;entryDy=0;" edge="1" parent="1" source="eSrv" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f07" value="agent token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7581;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eSrv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f16" value="gas-sensor configuration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5694;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eRoom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ FLOWS: ROUTER ============ -->
        <mxCell id="f08" value="traffic &amp;amp; link state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.0484;entryDx=0;entryDy=0;" edge="1" parent="1" source="eRtr" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f09" value="SNMP / RouterOS query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1129;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eRtr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ FLOWS: UPS ============ -->
        <mxCell id="f10" value="battery, load &amp;amp; runtime" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.2742;entryDx=0;entryDy=0;" edge="1" parent="1" source="eUps" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f11" value="SNMP query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3387;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eUps">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ FLOWS: AIRCON ============ -->
        <mxCell id="f12" value="IR command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5242;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eAc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ FLOWS: GOOGLE ============ -->
        <mxCell id="f13" value="authorisation code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6935;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eGoog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f14" value="verified identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.7581;entryDx=0;entryDy=0;" edge="1" parent="1" source="eGoog" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ FLOWS: EMAIL ============ -->
        <mxCell id="f15" value="alert &amp;amp; report e-mail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.9435;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="eMail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ LEGEND ============ -->
        <mxCell id="lgTitle" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="790" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgProc" value="n.0&lt;br&gt;Process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="820" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lgEnt" value="External entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="820" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lgFlow" value="data flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="845" as="sourcePoint" />
            <mxPoint x="620" y="845" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lgNote1" value="Reading it: every arrow is data crossing the system boundary. Note the two &lt;i&gt;pull&lt;/i&gt; relationships &#8212; the system asks the router and the UPS for their state, rather than being told &#8212; while the server room and the servers &lt;i&gt;push&lt;/i&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="905" width="1400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgNote2" value="&lt;b&gt;Balanced with the Level 1 DFD.&lt;/b&gt; The 16 flows above are composites: the 29 flows that cross the system boundary in Level 1 each roll up into exactly one of them, and every flow above has at least one Level 1 counterpart." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="931" width="1400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgNote3" value="Admin holds every IT Staff flow in addition to the four admin-exclusive flows drawn at both levels (registration approvals, enrollment keys, threshold rule edits and gas-sensor setup), so the two diagrams stay consistent." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="957" width="1400" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
