# ============================================================================
#  CSPC-ICTU Monitoring System — backend configuration
# ----------------------------------------------------------------------------
#  Copy this file to `backend/.env` and fill in section 1. Nothing else is
#  required to start:
#
#      cp backend/.env.example backend/.env
#
#  Generate your OWN secrets. Never reuse values from another deployment,
#     a chat log, or a screenshot — a secret that has been seen is spent.
#
#  Every setting below is optional unless marked REQUIRED. A blank line means
#  "use the default", and the defaults are sized for this system as deployed at
#  CSPC — change them only with a reason.
#
#  The full reasoning behind each value is in CLAUDE.md.
# ============================================================================


# ════════════════════════════════════════════════════════════════════════════
#  1. REQUIRED — the backend will not start, or will not let anyone in,
#     without these.
# ════════════════════════════════════════════════════════════════════════════

# Signs every session token. At least 32 characters or the backend refuses to
# boot. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Google sign-in ──────────────────────────────────────────────────────────
# Login is Google-only; there is no password login. Without these, nobody can
# sign in. From Google Cloud Console → APIs & Services → Credentials → OAuth
# 2.0 Client ID (type: Web application).
#
# The client's Authorized JavaScript origins must list the address people open
# the dashboard at (e.g. https://monitoring.cspc.edu.ph). Redirect URIs stay
# EMPTY — this app uses the postmessage flow.
#
# GOOGLE_CLIENT_ID must match VITE_GOOGLE_CLIENT_ID used to build the frontend,
# or sign-in fails with a mismatched-audience error naming neither file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in, comma-separated. Blank = cspc.edu.ph,my.cspc.edu.ph
GOOGLE_ALLOWED_DOMAINS=

# ── Databases ───────────────────────────────────────────────────────────────
# IGNORE THIS BLOCK IF YOU RUN WITH DOCKER COMPOSE. docker-compose.yml sets
# all of it from the root .env so the values cannot drift between the backend
# and the database containers. Fill it in only for a non-container install.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=


# ════════════════════════════════════════════════════════════════════════════
#  2. STRONGLY RECOMMENDED — everything works without these, but parts of the
#     system stay switched off or misreport.
# ════════════════════════════════════════════════════════════════════════════

# ── The ESP32 sensor box ────────────────────────────────────────────────────
# The sensor box's only credential. Must be IDENTICAL to DEVICE_SECRET in
# iot/esp32/env_monitor_v2/secrets.h — changing it means reflashing the box.
# Blank = every sensor handshake is rejected (logged once at boot).
# At least 24 characters, and the backend refuses to start on a value known to
# have been published. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_SECRET=

# ── Encryption at rest ──────────────────────────────────────────────────────
# 64 hex characters (32 bytes) each. Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SECRET_ENC_KEY protects agent install keys, agent tokens and SNMP community
# strings in the database — the file ops/db-backup writes offsite.
# MIKROTIK_ENC_KEY protects stored RouterOS passwords; REQUIRED if you monitor
# a MikroTik, and saving credentials throws without it.
#
# Once data is stored, do not change these casually — the stored values were
# encrypted under them. `npm run rekey -- --from-key <old>` rotates properly.
SECRET_ENC_KEY=
MIKROTIK_ENC_KEY=

# ── Public address & proxy ──────────────────────────────────────────────────
# WEB_ORIGIN: which dashboard origins may call this API (CORS), comma-separated.
#   e.g. https://monitoring.cspc.edu.ph
#   Blank = localhost + LAN defaults. `*` allows any origin (roaming LAN only).
WEB_ORIGIN=

# APP_PUBLIC_URL: the address put in account-approval emails, for someone who
# has never opened the system. Blank = the first WEB_ORIGIN entry.
APP_PUBLIC_URL=

# TRUST_PROXY: how many proxies sit in front of this backend. Blank = 2.
# A security control, not a formality. Too high and a client can forge its
# own IP, which breaks every rate limit and the audit trail. Count the real
# hops: 0 when nothing is in front, 1 behind one reverse proxy, 2 behind two.
TRUST_PROXY=

# ── Email (alerts, reports, account approvals) ──────────────────────────────
# Blank SMTP_USER/SMTP_PASS = email is off; the bell and toasts still work.
# Use a mailbox on the institution's own domain so existing SPF/DKIM authorize
# it — no DNS work needed. SMTP_PASS is a 16-character Google App Password,
# NOT the account password (needs 2-Step Verification enabled).
# Verify with: npm run mail:check <recipient>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Minimum severity that sends email: info | warning | critical. Blank=critical.
# Per-user opt-in still applies; a user with no preference row gets no email.
NOTIFY_EMAIL_MIN_SEVERITY=

# Force ALL email to one address, for testing. Includes account-approval
# mail, so a test approval notifies you instead of the new user. Blank = normal.
NOTIFY_EMAIL_TO=


# ════════════════════════════════════════════════════════════════════════════
#  3. OPTIONAL — sensible defaults. Leave blank unless you have a reason.
# ════════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
# blank = 3000
PORT=
# blank = 100kb
JSON_BODY_LIMIT=
# blank = 15552000 (180d). Only sent over real TLS
HSTS_MAX_AGE_SEC=
# blank = library default
HTTP_REQUEST_TIMEOUT_MS=
HTTP_HEADERS_TIMEOUT_MS=
HTTP_KEEPALIVE_TIMEOUT_MS=

# ── Sessions & rate limiting ────────────────────────────────────────────────
# ceiling on one sign-in; blank = 12
SESSION_MAX_HOURS=
# requests per window, per user; blank = 3000
RATE_LIMIT_MAX=
# blank = 15
RATE_LIMIT_WINDOW_MIN=
# failed socket handshakes per IP/15min; blank = 50
SOCKET_HANDSHAKE_MAX_FAILURES=
# blank = 1000000
SOCKET_MAX_PAYLOAD_BYTES=
# re-check live sockets against users; blank = 30000
SOCKET_REVOKE_SWEEP_MS=
# agent metric POST limit
AGENT_RATE_MAX=
# per-IP agent limit
AGENT_RATE_IP_MAX=
# agent enrollment-status polling limit
AGENT_STATUS_RATE_MAX=

# ── Database tuning ─────────────────────────────────────────────────────────
# blank = 10, shared by pollers + dashboard + agents
DB_POOL_SIZE=
# blank = 30. A backstop, not a performance budget
DB_STATEMENT_TIMEOUT_SEC=
INFLUX_TIMEOUT_MS=

# ── Go agents (server metrics) ──────────────────────────────────────────────
# DEPRECATED bootstrap fallback. Enrollment keys are minted in the UI
# (Server Metrics → Agent install keys). This exists only because a fresh
# database has no keys and no admin to mint one. Create a managed key, then
# BLANK this and restart.
AGENT_INSTALL_KEY=

# floor for the offline window; blank = 30
SERVER_OFFLINE_AFTER_SEC=
# agents send an empty heartbeat every 2s; a server is offline after this
# many seconds without one (3 missed beats). blank = 6. Older agents are unaffected
# and stay on the window above
SERVER_HEARTBEAT_TIMEOUT_SEC=
# after an agent announces a shutdown, ignore its last few posts for this long so
# they cannot flip it back Online and resolve the alert just raised; blank = 30
SERVER_SHUTDOWN_HOLD_SEC=
# when the sensor box counts as offline
ESP32_OFFLINE_AFTER_SEC=

# ── Fast offline detection ──────────────────────────────────────────────────
# One ICMP echo per online device on a short cycle, separate from the full polls.
# It can only mark a device DOWN — recovery stays with the real poll — and it
# ignores any device it has never seen answer ping, so equipment that blocks ICMP
# is never falsely marked offline. Without it, an outage surfaces at the next full
# poll: up to 60s for a router or UPS, 30s for a MikroTik.
# Set FAST_OFFLINE_CHECK=false to switch it off entirely.
FAST_OFFLINE_CHECK=
# how often to sweep, ms; blank = 5000
FAST_OFFLINE_CHECK_MS=
# consecutive missed replies before a device is flipped; blank = 2. One lost echo
# is not an outage, so 1 is not recommended.
FAST_OFFLINE_FAILS=
# per-echo timeout, ms; blank = 1000
FAST_OFFLINE_PING_TIMEOUT_MS=

# ── Routers, UPS, MikroTik ──────────────────────────────────────────────────
# blank = 60000
SNMP_POLL_INTERVAL_MS=
# ICMP echoes per poll; blank = 3
PING_COUNT=
# blank = 2000
PING_TIMEOUT_MS=
# blank = 30000
MIKROTIK_POLL_INTERVAL_MS=
# blank = 5000
MIKROTIK_API_TIMEOUT_MS=
# true verifies the router cert; stock RouterOS is self-signed
MIKROTIK_TLS_VERIFY=
# path to a CA file, only when TLS_VERIFY=true
MIKROTIK_TLS_CA=

# ── Alerting ────────────────────────────────────────────────────────────────
# same device+type won't re-alert within this; blank = 30
NOTIFY_COOLDOWN_MIN=
# normal readings before auto-resolve; blank = 3
ALERT_RECOVERY_SAMPLES=

# ── Predictive analytics ────────────────────────────────────────────────────
# how often forecasts are checked; blank = 6
ANALYTICS_ALERT_INTERVAL_H=
# ETA at/below this = critical; blank = 7
ANALYTICS_ALERT_CRITICAL_DAYS=
# blank = 30
ANALYTICS_ALERT_WARNING_DAYS=
# blank = 1440 (24h)
ANALYTICS_ALERT_COOLDOWN_MIN=
# blank = 30
ANALYTICS_ALERT_DISK_DAYS=
# blank = 90
ANALYTICS_ALERT_LINK_DAYS=
# blank = 180
ANALYTICS_ALERT_UPS_DAYS=
# false disables anomaly alerts; blank = on
ANALYTICS_ANOMALY_ALERTS=
# blank = 14
ANALYTICS_ANOMALY_DAYS=

# ── Environment sensor storage ──────────────────────────────────────────────
# The box sends every 3s; only STORAGE is throttled. Alerting and the live
# view are unaffected.
# blank = 30000. 0 = store every reading
ENV_PERSIST_INTERVAL_MS=
# ppm change forcing an immediate store; blank = 15
ENV_PERSIST_DEADBAND_GAS=
# °C; blank = 0.5
ENV_PERSIST_DEADBAND_TEMP=
# %RH; blank = 2
ENV_PERSIST_DEADBAND_HUM=
# only until the ESP32 first connects; blank = 2
AIRCON_MAX_IR_CHANNELS=

# ── On-site backup ──────────────────────────────────────────────────────────
# Under Docker the default lives on a volume. Leave BACKUP_DIR blank and let
# docker-compose.yml mount it, or point it at a mounted USB/SD drive.
# false disables; blank = enabled
BACKUP_ENABLED=
# blank = backend/backups
BACKUP_DIR=
# blank = 5000
BACKUP_FLUSH_MS=
# blank = 30
BACKUP_RETENTION_DAYS=
# true checks that an offsite sync happened; blank = off
BACKUP_OFFSITE_ENABLED=
# file the rclone job stamps on success
BACKUP_OFFSITE_MARKER=
# warn if no sync within this; blank = 26
BACKUP_OFFSITE_MAX_AGE_HOURS=

# ── Data retention ──────────────────────────────────────────────────────────
# SYSTEM_LOG_RETENTION_DAYS is quoted in the Privacy Notice. Changing it
# means changing that document too.
# audit trail; blank = 365
SYSTEM_LOG_RETENTION_DAYS=
# alerts; blank = 30
NOTIFY_RETENTION_DAYS=
# generated reports + files; blank = 90
REPORT_RETENTION_DAYS=
# device event logs
DEVICE_LOG_RETENTION_DAYS=
# widest period one report may cover; blank = 366
REPORT_MAX_PERIOD_DAYS=
