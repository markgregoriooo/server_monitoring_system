# ── Frontend config (Vite reads VITE_* at startup) ──────────────────────────────
# Copy this file to `.env` and edit if you need to. Restart `npm run dev` after changes.

# Backend base URL for the dashboard (Axios + Socket.IO).
#
# Leave BLANK to auto-detect from the page's address (recommended for LAN): the dashboard
# reaches the backend at whatever host you open it from, on port 3000 — so moving between
# networks/IPs needs NO change here.
#
# Set it ONLY when the backend is on a different host than the dashboard, or for HTTPS:
#   VITE_API_URL=http://192.168.100.9:3000
#   VITE_API_URL=https://monitor.cspc.edu.ph
VITE_API_URL=

# ── Branding ────────────────────────────────────────────────────────────────────
# System name shown across the UI (sidebar, login, header breadcrumb, browser tab).
# Vite embeds these at BUILD time → restart `npm run dev` after changing them.
# Leave blank to use the built-in CSPC-ICTU defaults (see frontend/src/branding.ts).
VITE_APP_NAME=CSPC-ICTU
VITE_APP_FULL_NAME=Camarines Sur Polytechnic Colleges Information and Communications Technology Unit
VITE_APP_SUBTITLE=MONITORING
VITE_APP_TAGLINE=SERVER INFRASTRUCTURE MONITORING SYSTEM
VITE_LOGO_TEXT=CC
# Optional logo image placed in frontend/public/, e.g. /logo.png. Blank = text initials.
VITE_LOGO_SRC=

# ── Google OAuth ────────────────────────────────────────────────────────────────
# "Continue with Google" client ID (public, not a secret). Required for login.
# Create one at Google Cloud Console → Google Auth Platform → Clients (Web app),
# Authorized JavaScript origin = your dashboard URL (e.g. http://localhost:5173).
# Must match GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=
