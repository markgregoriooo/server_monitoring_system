# ============================================================================
#  Compose settings — copy to `.env` in this same folder and fill in.
#      cp .env.docker.example .env
#
#  This file is ONLY for the things the containers need to find each other:
#  the database credentials, the InfluxDB token, and the two values baked into
#  the dashboard at build time.
#
#  The application's own secrets stay where they already are, in backend/.env
#  (JWT_SECRET, DEVICE_SECRET, GOOGLE_CLIENT_SECRET, SMTP_PASS, the encryption
#  keys). Compose reads that file directly — do not copy those values here.
#
#   `.env` is gitignored. This example file is not, so never put a real
#     password in it.
# ============================================================================

# ── MariaDB ─────────────────────────────────────────────────────────────────
# Set these BEFORE the first `docker compose up`. They are written into the
# database when its volume is created; changing them later does not change the
# stored user, so a later edit just breaks the login.
DB_ROOT_PASSWORD=change-me-root
DB_NAME=cspc-ictu-monitoring-system
DB_USER=cspc
DB_PASSWORD=change-me

# The CSPC Google account that is the FIRST ADMIN. It is created as an active
# admin when the database is first built, so the first sign-in goes straight in
# instead of landing "pending" with nobody able to approve it. No password —
# sign in with that Google account. Everyone else registers and is approved by
# this admin from User Management. First-run only, like the three values above:
# setting it later does nothing (promote by hand — deployment-guide.md §4.3).
# Must be an address GOOGLE_ALLOWED_DOMAINS accepts (@cspc.edu.ph by default).
FIRST_ADMIN_EMAIL=magregorio@my.cspc.edu.ph

# ── InfluxDB 2 ──────────────────────────────────────────────────────────────
# Also first-run only. The password must be at least 8 characters or the
# container's own setup step fails.
INFLUX_USERNAME=cspc
INFLUX_PASSWORD=change-me-8-chars-min
INFLUX_ORG=cspc-ictu
INFLUX_BUCKET=monitoring
# The backend authenticates with this. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INFLUX_TOKEN=change-me

# ── Dashboard build args ────────────────────────────────────────────────────
# Built into the JavaScript by Vite. Change either one and rebuild:
#   docker compose up -d --build frontend
#
# VITE_API_URL: where the browser sends /api and /socket.io.
#   Behind a proxy with a hostname: the public address, no port.
#       VITE_API_URL=https://datacenter.cspc.edu.ph
#   Plain LAN, no proxy: leave blank. The dashboard then uses the host it was
#   opened from on port 3001.
VITE_API_URL=

# The OAuth client id — public by design, it identifies the app to Google.
# Must match GOOGLE_CLIENT_ID in backend/.env, or sign-in fails with a
# mismatched-audience error that names neither file.
VITE_GOOGLE_CLIENT_ID=

# ── Dashboard branding (optional) ───────────────────────────────────────────
# Also baked in at build time. Leave them out entirely and the build uses the
# CSPC defaults shown here — they exist so another institution can rebrand
# without touching code. VITE_LOGO_SRC is a file in frontend/public/.
#VITE_APP_NAME=CSPC-ICTU
#VITE_APP_FULL_NAME=Camarines Sur Polytechnic Colleges – Information and Communications Technology Unit
#VITE_APP_SUBTITLE=MONITORING
#VITE_APP_TAGLINE=SERVER INFRASTRUCTURE MONITORING SYSTEM
#VITE_LOGO_TEXT=CC
#VITE_LOGO_SRC=/logo-128.png

# ── On-site backup folder ───────────────────────────────────────────────────
# Where the backend's backup files land ON THIS SERVER. Point it at the mounted
# USB / SD drive — see ops/backup-setup-linux.md. Blank keeps them in a Docker
# volume on the main disk, which the nightly dump + Backblaze upload cannot use
# (the scripts in ops/ switch to their Docker mode only when this is set).
# Must be owned by uid 1000:  sudo chown -R 1000:1000 /mnt/backup/backups
# Then: docker compose up -d backend
#BACKUP_HOST_DIR=/mnt/backup/backups

# ── Everything else ─────────────────────────────────────────────────────────
TZ=Asia/Manila
