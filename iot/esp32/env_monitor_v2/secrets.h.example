/*
 * secrets.h.example: template for the values the sketch needs.
 *
 * Copy it to `secrets.h` in the same folder as env_monitor_v2.ino and fill it in.
 * `secrets.h` is gitignored; this template is not.
 *
 *     cp secrets.h.example secrets.h
 *
 * Only DEVICE_SECRET is required. WiFi and the backend address are set from a phone
 * through the sensor's setup page on first boot and stored in NVS flash
 * (`esp32-wifi-provisioning.md`), so no WiFi password is kept in the repository.
 */
#ifndef SECRETS_H
#define SECRETS_H

/*
 * ---- Device authentication (required) ------------------------
 * Must match DEVICE_SECRET in backend/.env exactly, or the handshake is rejected and the
 * box never connects. Sent as an HTTP header on the WebSocket upgrade (see
 * socketIO.begin() in env_monitor_v2.ino).
 *
 * It stays compiled in: anyone with it can write readings as the device. To rotate it,
 * put the same new value here and in backend/.env, then reflash. The backend refuses to
 * start with a known-leaked value or one shorter than 24 characters.
 */
#define DEVICE_SECRET "change-me-to-match-backend-env"

/*
 * ---- Optional fallbacks ----------------------------------------------------
 * Leave these commented out for a box that will be set up through the portal (every box
 * given to ICTU); that is what makes the portal appear on first boot.
 *
 * If defined, they are used only while NVS is empty:
 *   1. A box flashed before WiFi setup existed keeps joining its old network.
 *   2. A dev box joins your WiFi without the portal after every reflash.
 *
 * Settings saved through the portal always win, even after a reflash (NVS survives
 * uploads). Press BOOT early in the boot (see below) to change them.
 *
 * 2.4 GHz only (the ESP32 has no 5 GHz radio). BACKEND_HOST is the LAN IP of the machine
 * running backend/src/server.js, and BACKEND_PORT its PORT from backend/.env. Use an IP,
 * not a hostname.
 */
// #define WIFI_SSID     "YOUR_WIFI_SSID"
// #define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
// #define BACKEND_HOST  "192.168.1.10"
// #define BACKEND_PORT  3001

/*
 * ---- Changing the settings of a box that is already set up ---------------------------
 * Power it on, wait ~4 s for the RGB LED to turn magenta, then press BOOT. The setup page
 * comes back. Do not hold BOOT while powering on: GPIO 0 is a strapping pin, and the
 * ESP32 would start in download mode instead of running the sketch.
 */

#endif  // SECRETS_H
