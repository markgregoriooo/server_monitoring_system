/*
 * secrets.h.example — template for the per-deployment values the sketch needs.
 *
 * Copy this file to `secrets.h` in the SAME folder as env_monitor_v2.ino and fill in
 * your own values. `secrets.h` is gitignored; this template is not.
 *
 *     cp secrets.h.example secrets.h
 *
 * These four things are per-installation, not per-project: the WiFi the box joins, the
 * machine the backend runs on, and the shared secret that authenticates the device.
 * They used to sit in the sketch itself, which meant a real WiFi password and the real
 * DEVICE_SECRET were committed to the repository.
 */
#ifndef SECRETS_H
#define SECRETS_H

/* ---- WiFi the ESP32 joins (2.4 GHz only — the ESP32 has no 5 GHz radio) ---- */
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

/* ---- Backend that receives the readings ----------------------------------
 * The LAN IP of the machine running backend/src/server.js, and its PORT from
 * backend/.env. Not a hostname: the ESP32 resolves DNS through the same LAN, and an
 * IP removes one thing that can fail at boot.
 */
#define BACKEND_HOST "192.168.1.10"
#define BACKEND_PORT 3000

/* ---- Device authentication -----------------------------------------------
 * MUST match DEVICE_SECRET in backend/.env exactly, or the socket handshake is
 * rejected and the box never connects. Sent as an HTTP header on the WebSocket
 * upgrade — see the socketIO.begin() call in env_monitor_v2.ino.
 */
#define DEVICE_SECRET "change-me-to-match-backend-env"

#endif  // SECRETS_H
