/*
 * secrets.h.example — template for the per-deployment values the sketch needs.
 *
 * Copy this file to `secrets.h` in the SAME folder as env_monitor_v2.ino and fill it in.
 * `secrets.h` is gitignored; this template is not.
 *
 *     cp secrets.h.example secrets.h
 *
 * ⚠️ SINCE THE WIFI PROVISIONING CHANGE, THIS FILE NEEDS ONE VALUE: DEVICE_SECRET.
 * The WiFi network and the backend address are no longer compiled in — they are set from a
 * phone through the sensor's own setup page on first boot and stored in NVS flash
 * (`esp32-wifi-provisioning.md`). ICTU staff have no Arduino IDE, so an SSID change or a
 * new backend IP used to mean a reflash by us; now it does not.
 *
 * It is also a security win: a WiFi password can no longer reach the repository at all.
 * The real one was committed at 5f5a084 and is still readable in the history of a pushed
 * remote — removing it from the source only stopped NEW exposure.
 */
#ifndef SECRETS_H
#define SECRETS_H

/* ---- Device authentication — THE ONE REQUIRED VALUE ------------------------
 * MUST match DEVICE_SECRET in backend/.env exactly, or the socket handshake is rejected
 * and the box never connects. Sent as an HTTP header on the WebSocket upgrade — see the
 * socketIO.begin() call in env_monitor_v2.ino.
 *
 * This one stays compiled in deliberately. It is not the installer's to choose, a wrong
 * value fails silently, and presenting it to the backend is enough to write environment
 * readings and replay backfill under any timestamp — see the DEVICE_SECRET note in
 * CLAUDE.md. Rotating it is TWO-SIDED: the same new value here AND in backend/.env, then
 * reflash. The backend refuses to start on a value known to have been published, or on
 * anything shorter than 24 characters.
 */
#define DEVICE_SECRET "change-me-to-match-backend-env"

/* ---- OPTIONAL fallbacks ----------------------------------------------------
 * Leave these commented out for a box that will be provisioned through the setup portal —
 * which is every box handed to ICTU, and the state that makes the portal appear on first
 * boot.
 *
 * Define them and they become the FALLBACK used only while NVS is empty. Two reasons they
 * still exist:
 *
 *   1. A box flashed BEFORE the provisioning change has nothing in NVS. With these defined
 *      it comes up on its own network exactly as it used to, instead of turning into an
 *      access point the day it is updated.
 *   2. A bench/dev box joins your own WiFi with no portal step every time you reflash.
 *
 * Anything saved through the portal WINS over these, permanently, even after a reflash —
 * NVS survives an upload. Press BOOT early in the boot (see below) to change what is saved.
 *
 * ⚠️ 2.4 GHz only — the ESP32 has no 5 GHz radio. BACKEND_HOST is the LAN IP of the machine
 * running backend/src/server.js, and BACKEND_PORT its PORT from backend/.env. An IP rather
 * than a hostname: it removes one thing that can fail at boot.
 */
// #define WIFI_SSID     "YOUR_WIFI_SSID"
// #define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
// #define BACKEND_HOST  "192.168.1.10"
// #define BACKEND_PORT  3000

/* ---- Re-configuring a box that is already set up ---------------------------
 * Power it on, wait ~4 s for the RGB LED to turn MAGENTA, then press the BOOT button. The
 * setup page comes back.
 *
 * ⚠️ NOT "hold BOOT while powering on". GPIO 0 is a strapping pin: held low at reset the
 * ESP32 enters serial download mode and the sketch never runs at all.
 */

#endif  // SECRETS_H
