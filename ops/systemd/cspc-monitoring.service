# ============================================================================
#  CSPC-ICTU Monitoring System — backend service unit
# ----------------------------------------------------------------------------
#  Install:  see ops/systemd/README.md   (deployment-guide.md §3.3)
#
#  Runs the backend under systemd, so its output goes to journald (captured,
#  rotated, kept across restarts). See audits/logging-monitoring-2026-08-25.md §8.
#
#  Adjust User/Group and the three paths below for the deployment.
# ============================================================================

[Unit]
Description=CSPC-ICTU Monitoring System (backend API + pollers)
Documentation=file:/opt/cspc/deployment-guide.md

# `network-online` rather than `network`: the SNMP and MikroTik pollers dial out
# on their first tick, and the backend binds 0.0.0.0 for the Go agents and the
# ESP32. Starting before an address exists produces a confusing first minute.
After=network-online.target mariadb.service influxdb.service
Wants=network-online.target

# Not `Requires=`: the backend keeps running when a database is down, and Requires would
# stop monitoring during a MariaDB blip.
After=nginx.service

[Service]
Type=simple

# ── Identity ────────────────────────────────────────────────────────────────
# Never root. The account needs read access to the app and .env, and write access to
# reports/ and BACKUP_DIR. Create it with:  sudo useradd --system --home /opt/cspc cspc
User=cspc
Group=cspc

# ── WorkingDirectory ────────────────────────────────────────────────────────
# The app no longer depends on it (config/env.js resolves paths from BACKEND_ROOT), but
# it is still set so child processes and core dumps have a sensible directory.
WorkingDirectory=/opt/cspc/backend
ExecStart=/usr/bin/node src/server.js

# ── Environment ─────────────────────────────────────────────────────────────
# No EnvironmentFile= here: the app loads .env itself with dotenv. systemd's parser
# treats inline `#` comments and quotes differently, so loading it twice could change
# values.
Environment=NODE_ENV=production

# ── Restart policy ──────────────────────────────────────────────────────────
# src/server.js exits on an uncaught exception by design and leaves restarting to the
# service manager; this is it.
Restart=always
RestartSec=5s

# Don't let a crash-loop hammer MariaDB: 5 starts in 60s, then stop and stay
# stopped so a human looks at the journal.
StartLimitIntervalSec=60
StartLimitBurst=5

# ── Shutdown ────────────────────────────────────────────────────────────────
# On SIGTERM server.js flushes buffered backup samples first, then closes the HTTP
# server within its own 3s limit. This timeout must be longer, or systemd would kill it
# mid-flush.
KillSignal=SIGTERM
TimeoutStopSec=15s

# ── Logging ───────────────────────────────────
# Everything the app writes with console.* goes to journald. Follow it with:
#     journalctl -u cspc-monitoring -f
# Filter by the app's own tags:
#     journalctl -u cspc-monitoring | grep -E '\[AUTH|\[AUTHZ|\[RATE|\[POLICY'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cspc-monitoring

# ── Hardening ───────────────────────────────────────────────────────────────
# Kept conservative; read the note below before adding more.
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=false

# Before adding `NoNewPrivileges=true`: services/icmpPing.js runs the OS `ping` for
# router latency and packet loss. On Linux /bin/ping is setuid-root or has
# cap_net_raw+ep, and NoNewPrivileges=true blocks both. The app handles that (logs
# `[ICMP] ping could not be started (...)` once and skips the sample instead of
# marking devices offline), but latency and packet-loss monitoring stop working.
#
# To enable it anyway, first check that unprivileged ICMP is allowed:
#     sysctl net.ipv4.ping_group_range          # must include the cspc group's GID
#     sudo -u cspc ping -c1 <a-router-ip>       # must succeed
# then add NoNewPrivileges=true and check again with:
#     sudo -u cspc bash -c 'cd /opt/cspc/backend && npm run probe -- <router-ip>'
#
# ProtectSystem=strict also needs ReadWritePaths for reports/ and BACKUP_DIR (which
# may be a removable mount), or reports and the on-site backup fail. Uncomment both
# together, and test:
# ProtectSystem=strict
# ReadWritePaths=/opt/cspc/backend/reports /mnt/backup

[Install]
WantedBy=multi-user.target
